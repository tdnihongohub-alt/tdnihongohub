rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function signed() { return request.auth != null; }
  function verified() { return signed() && request.auth.token.email_verified == true; }
  function teacher() { return signed() && exists(/databases/$(database)/documents/teachers/$(request.auth.uid)) && get(/databases/$(database)/documents/teachers/$(request.auth.uid)).data.enabled == true; }
  function studentId() { return get(/databases/$(database)/documents/studentLinks/$(request.auth.uid)).data.studentId; }
  function ownStudent(id) { return verified() && studentId() == id; }
  function activeStudent() { return verified() && get(/databases/$(database)/documents/students/$(studentId())).data.active == true; }
  function courseAllowed(id) {
   return verified() && ((get(/databases/$(database)/documents/courses/$(id)).data.access == 'free' && get(/databases/$(database)/documents/courses/$(id)).data.get('approvalRequired',false) == false && get(/databases/$(database)/documents/courses/$(id)).data.published == true)
    || (activeStudent() && get(/databases/$(database)/documents/courseAccess/$(studentId() + '_' + id)).data.active == true));
  }
  function courseGrant(id) { return /databases/$(database)/documents/courseAccess/$(studentId() + '_' + id); }
  function allModules(id) { return exists(courseGrant(id)) && get(courseGrant(id)).data.get('allModules',false) == true; }
  function wholeCourseAllowed(id) { return allModules(id) && get(courseGrant(id)).data.active == true; }
  function batchAllowed(id) {
   let module = get(/databases/$(database)/documents/batches/$(id)).data;
   return activeStudent() && (allModules(module.courseId)
    ? module.active == true && wholeCourseAllowed(module.courseId)
    : get(/databases/$(database)/documents/enrollments/$(studentId() + '_' + id)).data.status == 'active');
  }
  function shortString(value,max) { return value is string && value.size() <= max; }
  function link(value) { return value == '' || (value is string && value.size() <= 2000 && value.matches('https?://.*')); }
  function validClaim(d) {
   return ownStudent(d.studentId) && d.amount is number && d.amount > 0 && d.amount < 10000000
    && d.month is string && d.month.matches('[0-9]{4}-[0-9]{2}') && d.paidOn is string && d.paidOn.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
    && shortString(d.reference,1000) && d.reference.size() > 0 && link(d.receiptUrl)
    && exists(/databases/$(database)/documents/feeMonths/$(d.studentId + '_' + d.batchId + '_' + d.month));
  }
  function assignmentOpen(a) { return a.published == true && a.get('releaseAt',0) <= request.time.toMillis(); }
  function assignmentAudience(a) {
   return a.get('batchIds',[]).size() > 1 || a.get('batchId','') == '__multiple__'
    ? (activeStudent() && (allModules(a.courseId) ? wholeCourseAllowed(a.courseId) : a.get('batchIds',[]).hasAny(get(/databases/$(database)/documents/studentLinks/$(request.auth.uid)).data.get('activeBatchIds',[]))))
    : (a.get('audience','') == 'batches' && a.get('batchIds',[]).size() == 0 ? false : (a.get('batchId','') == '' || batchAllowed(a.batchId)));
  }
  function acceptsWork(a) { return assignmentOpen(a) && (a.get('allowLate',true) == true || a.get('deadlineAt',0) >= request.time.toMillis()); }
  function quizTimer(d) { return get(/databases/$(database)/documents/quizTimers/$(d.timerId)).data; }
  function timerEnd(d,a) { let end = quizTimer(d).startedAt.toMillis() + quizTimer(d).durationMinutes * 60000; return a.get('allowLate',true) == false && a.get('deadlineAt',0) > 0 && a.deadlineAt < end ? a.deadlineAt : end; }
  function timedResponse(d,a) {
   return a.get('timeLimitMinutes',0) == 0 && d.get('timerId','') == '' ? d.get('timedOut',false) == false :
    (d.get('timerId','') == d.studentId + '_' + d.assignmentId + '_' + string(d.history.size())
     && quizTimer(d).studentId == d.studentId && quizTimer(d).assignmentId == d.assignmentId
     && (d.get('timedOut',false) == true ? d.status == 'submitted' && request.time.toMillis() >= timerEnd(d,a) : request.time.toMillis() < timerEnd(d,a)));
  }
  match /quizTimers/{id} {
   allow get: if teacher() || (verified() && (resource == null ? id.matches(studentId() + '_.*') : ownStudent(resource.data.studentId)));
   allow list, update, delete: if teacher();
   allow create: if ownStudent(request.resource.data.studentId)
    && request.resource.data.keys().hasOnly(['studentId','assignmentId','attemptNumber','durationMinutes','startedAt'])
    && request.resource.data.attemptNumber is int && request.resource.data.attemptNumber >= 0
    && id == request.resource.data.studentId + '_' + request.resource.data.assignmentId + '_' + string(request.resource.data.attemptNumber)
    && request.resource.data.startedAt == request.time
    && request.resource.data.durationMinutes == get(/databases/$(database)/documents/assignments/$(request.resource.data.assignmentId)).data.get('timeLimitMinutes',0)
    && request.resource.data.durationMinutes >= 1 && request.resource.data.durationMinutes <= 240
    && acceptsWork(get(/databases/$(database)/documents/assignments/$(request.resource.data.assignmentId)).data)
    && assignmentAudience(get(/databases/$(database)/documents/assignments/$(request.resource.data.assignmentId)).data)
    && courseAllowed(get(/databases/$(database)/documents/assignments/$(request.resource.data.assignmentId)).data.courseId)
    && ((!exists(/databases/$(database)/documents/submissions/$(request.resource.data.studentId + '_' + request.resource.data.assignmentId)) && request.resource.data.attemptNumber == 0)
     || (get(/databases/$(database)/documents/submissions/$(request.resource.data.studentId + '_' + request.resource.data.assignmentId)).data.status in ['draft','returned'] && get(/databases/$(database)/documents/submissions/$(request.resource.data.studentId + '_' + request.resource.data.assignmentId)).data.history.size() == request.resource.data.attemptNumber));
  }
  function validSubmission(d) {
   return ownStudent(d.studentId) && d.assignmentId is string && d.courseId is string
    && get(/databases/$(database)/documents/assignments/$(d.assignmentId)).data.courseId == d.courseId
    && assignmentAudience(get(/databases/$(database)/documents/assignments/$(d.assignmentId)).data) && (acceptsWork(get(/databases/$(database)/documents/assignments/$(d.assignmentId)).data) || (d.get('timedOut',false) == true && get(/databases/$(database)/documents/assignments/$(d.assignmentId)).data.published == true)) && courseAllowed(d.courseId)
    && timedResponse(d,get(/databases/$(database)/documents/assignments/$(d.assignmentId)).data)
    && d.get('formAnswers',{}) is map && d.get('late',false) is bool
    && d.status in ['draft','submitted'] && shortString(d.answer,20000) && link(d.fileUrl)
    && (d.status == 'draft' || d.answer.size() > 0 || d.fileUrl.size() > 0 || d.get('formAnswers',{}).size() > 0 || d.get('timedOut',false) == true);
  }

  match /teachers/{id} { allow get: if signed() && request.auth.uid == id; allow list, write: if false; }
  match /settings/{id} { allow read: if true; allow write: if teacher(); }
  match /fileGrants/{id} {
   function validGrant(d){
    return verified() && id == request.auth.uid + '_' + d.name && d.uid == request.auth.uid
     && d.keys().hasOnly(['uid','path','kind','recordId','owner','name','operation','issuedAt'])
     && d.kind in ['lesson','worksheet','submission'] && d.operation in ['read','write']
     && d.issuedAt == request.time && shortString(d.recordId,1500) && d.recordId.matches('[^/]+')
     && shortString(d.owner,1500) && d.owner.matches('[^/]+') && shortString(d.name,160) && d.name.matches('[^/]+')
     && d.path == (d.kind == 'lesson' ? 'lessonFiles/' : d.kind == 'worksheet' ? 'worksheets/' : 'submissions/') + d.recordId + '/' + d.owner + '/' + d.name;
   }
   function canRead(d){
    return teacher() || (d.kind == 'submission' ? d.owner == request.auth.uid :
     d.kind == 'lesson' ? (get(/databases/$(database)/documents/lessons/$(d.recordId)).data.published == true &&
      ((get(/databases/$(database)/documents/lessons/$(d.recordId)).data.visibility == 'public' && get(/databases/$(database)/documents/lessons/$(d.recordId)).data.get('batchId','') == '') ||
      (courseAllowed(get(/databases/$(database)/documents/lessons/$(d.recordId)).data.courseId) && assignmentAudience(get(/databases/$(database)/documents/lessons/$(d.recordId)).data)))) :
     (assignmentOpen(get(/databases/$(database)/documents/assignments/$(d.recordId)).data) && courseAllowed(get(/databases/$(database)/documents/assignments/$(d.recordId)).data.courseId) && assignmentAudience(get(/databases/$(database)/documents/assignments/$(d.recordId)).data)));
   }
   function canWrite(d){
    return get(/databases/$(database)/documents/settings/uploads).data.enabled == true && d.owner == request.auth.uid &&
     (teacher() ? d.kind in ['lesson','worksheet'] : d.kind == 'submission' &&
      acceptsWork(get(/databases/$(database)/documents/assignments/$(d.recordId)).data) &&
      courseAllowed(get(/databases/$(database)/documents/assignments/$(d.recordId)).data.courseId) && assignmentAudience(get(/databases/$(database)/documents/assignments/$(d.recordId)).data) &&
      (!exists(/databases/$(database)/documents/submissions/$(studentId() + '_' + d.recordId)) || get(/databases/$(database)/documents/submissions/$(studentId() + '_' + d.recordId)).data.status in ['draft','returned']));
   }
   allow create, update: if validGrant(request.resource.data) && (request.resource.data.operation == 'read' ? canRead(request.resource.data) : canWrite(request.resource.data));
   allow get: if verified() && resource.data.uid == request.auth.uid;
   allow delete: if teacher() || (verified() && resource.data.uid == request.auth.uid);
  }
  match /users/{id} {
   allow get: if teacher() || (signed() && request.auth.uid == id);
   allow list: if teacher();
   function validBatch(d) {
    return (d.get('preferredBatchId','').size() > 0
      && shortString(d.preferredBatchId,1500)
      && get(/databases/$(database)/documents/batches/$(d.preferredBatchId)).data.active == true
      && get(/databases/$(database)/documents/batches/$(d.preferredBatchId)).data.name == d.preferredBatch)
     || (resource != null && resource.data.get('registrationCompleted',false) == true
      && d.get('preferredBatchId','') == resource.data.get('preferredBatchId','')
      && d.preferredBatch == resource.data.preferredBatch);
   }
   function validProfile() {
    let d = request.resource.data;
    return signed() && request.auth.uid == id
     && d.keys().hasOnly(['displayName','email','phone','age','preferredBatch','preferredBatchId','preferredCourseId','registrationCompleted','registeredAt','city','school','candidateType'])
     && shortString(d.get('city',''),120) && shortString(d.get('school',''),200)
     && d.get('candidateType','') in ['','school','private']
     && (d.get('candidateType','') == '' || (d.get('city','').size() > 0 && (d.candidateType == 'private' || d.get('school','').size() > 0)))
     && d.email == request.auth.token.email && shortString(d.displayName,200) && shortString(d.phone,40)
     && d.get('registrationCompleted',false) is bool
     && (d.get('registrationCompleted',false) == false || (d.displayName.size() > 0
      && d.phone.matches('[+]?[0-9]{9,15}') && d.age is int && d.age >= 5 && d.age <= 120
      && (d.get('preferredCourseId','') != ''
       ? shortString(d.preferredCourseId,1500) && get(/databases/$(database)/documents/courses/$(d.preferredCourseId)).data.published == true && get(/databases/$(database)/documents/courses/$(d.preferredCourseId)).data.get('active',true) == true
       : shortString(d.preferredBatch,200) && d.preferredBatch.size() > 0 && validBatch(d))
      && shortString(d.registeredAt,40) && d.registeredAt.size() > 0));
   }
   allow create: if validProfile();
   allow update: if validProfile() && (resource.data.get('registrationCompleted',false) == false || request.resource.data.get('registrationCompleted',false) == true);
   allow delete: if teacher();
  }
  match /studentLinks/{id} { allow get: if teacher() || (verified() && request.auth.uid == id); allow list, write: if teacher(); }
  match /students/{id} { allow read: if teacher() || ownStudent(id); allow write: if teacher(); }
  match /teacherNotes/{id} { allow read, write: if teacher(); }
  match /courses/{id} { allow read: if teacher() || resource.data.published == true; allow get: if activeStudent() && exists(courseGrant(id)) && get(courseGrant(id)).data.active == true; allow write: if teacher(); }
  match /batches/{id} { allow read: if teacher() || resource.data.active == true; allow write: if teacher(); }
  match /enrollments/{id} { allow read: if teacher() || ownStudent(resource.data.studentId); allow write: if teacher(); }
  match /courseAccess/{id} { allow read: if teacher() || ownStudent(resource.data.studentId); allow write: if teacher(); }
  match /lessons/{id} {
   allow read: if teacher() || (resource.data.published == true && ((resource.data.visibility == 'public' && resource.data.get('batchId','') == '') || (courseAllowed(resource.data.courseId) && assignmentAudience(resource.data))));
   allow write: if teacher();
  }
  match /practiceSeries/{id} { allow read: if teacher() || batchAllowed(resource.data.batchId); allow write: if teacher(); }
  match /sessions/{id} { allow read: if teacher() || batchAllowed(resource.data.batchId); allow write: if teacher(); }
  match /assignments/{id} { allow read: if teacher() || (assignmentOpen(resource.data) && assignmentAudience(resource.data) && courseAllowed(resource.data.courseId)); allow write: if teacher(); }
  match /questions/{id} { allow read: if teacher() || (resource.data.published == true && courseAllowed(resource.data.courseId)); allow write: if teacher(); }
  match /announcements/{id} { allow read: if teacher() || batchAllowed(resource.data.batchId); allow write: if teacher(); }
  match /accessRequests/{id} {
   allow read: if teacher() || (verified() && resource.data.uid == request.auth.uid);
   allow create: if verified() && id == request.auth.uid + '_' + request.resource.data.courseId
    && request.resource.data.keys().hasOnly(['uid','studentId','courseId','status','message','createdAt'])
    && request.resource.data.uid == request.auth.uid && request.resource.data.status == 'pending'
    && get(/databases/$(database)/documents/courses/$(request.resource.data.courseId)).data.published == true
    && shortString(request.resource.data.message,2000);
   allow update, delete: if teacher();
  }
  match /savedCourses/{id} {
   allow read: if teacher() || (verified() && resource.data.uid == request.auth.uid);
   allow create: if verified() && id == request.auth.uid + '_' + request.resource.data.courseId
    && request.resource.data.keys().hasOnly(['uid','courseId']) && request.resource.data.uid == request.auth.uid
    && get(/databases/$(database)/documents/courses/$(request.resource.data.courseId)).data.access == 'free'
    && get(/databases/$(database)/documents/courses/$(request.resource.data.courseId)).data.get('approvalRequired',false) == false
    && get(/databases/$(database)/documents/courses/$(request.resource.data.courseId)).data.published == true;
   allow update: if verified() && resource.data.uid == request.auth.uid && request.resource.data == resource.data;
   allow delete: if teacher() || (verified() && resource.data.uid == request.auth.uid);
  }
  match /communityLinks/{id} {
   allow read: if teacher() || (resource.data.active == true && (resource.data.get('visibility','students') == 'public' || (resource.data.batchId == '' ? activeStudent() : batchAllowed(resource.data.batchId))));
   allow write: if teacher();
  }
  match /levelAttempts/{id} {
   function validLevelAttempt(d) {
    return verified() && d.keys().hasOnly(['uid','quizId','edition','score','total','completedAt'])
     && d.uid == request.auth.uid && d.edition == '2026-11'
     && d.quizId in ['AL-B01','AL-I01','AL-H01','N5-B01','N5-I01','N5-H01','N4-B01','N4-I01','N4-H01']
     && d.total == 3 && d.score is number && d.score == int(d.score) && d.score >= 0 && d.score <= 3
     && shortString(d.completedAt,40);
   }
   allow read: if teacher() || (verified() && resource.data.uid == request.auth.uid);
   allow create: if validLevelAttempt(request.resource.data);
   allow update: if verified() && resource.data.uid == request.auth.uid && request.resource.data == resource.data;
   allow delete: if teacher();
  }
  match /quizAttempts/{id} {
   allow read: if teacher() || (verified() && resource.data.uid == request.auth.uid);
   allow create: if verified() && request.resource.data.uid == request.auth.uid
    && request.resource.data.keys().hasOnly(['uid','courseId','topic','score','total','completedAt'])
    && courseAllowed(request.resource.data.courseId)
    && shortString(request.resource.data.topic,200)
    && request.resource.data.total is number && request.resource.data.total == int(request.resource.data.total) && request.resource.data.total > 0 && request.resource.data.total <= 500
    && request.resource.data.score is number && request.resource.data.score == int(request.resource.data.score) && request.resource.data.score >= 0 && request.resource.data.score <= request.resource.data.total
    && shortString(request.resource.data.completedAt,40);
   allow update, delete: if teacher();
  }
  match /progress/{id} {
   allow read: if teacher() || (verified() && resource.data.uid == request.auth.uid);
   allow create, update: if verified() && id == request.auth.uid + '_' + request.resource.data.lessonId
    && request.resource.data.keys().hasOnly(['uid','lessonId','courseId','complete']) && request.resource.data.uid == request.auth.uid
    && request.resource.data.complete is bool && courseAllowed(request.resource.data.courseId)
    && get(/databases/$(database)/documents/lessons/$(request.resource.data.lessonId)).data.published == true
    && assignmentAudience(get(/databases/$(database)/documents/lessons/$(request.resource.data.lessonId)).data)
    && get(/databases/$(database)/documents/lessons/$(request.resource.data.lessonId)).data.courseId == request.resource.data.courseId;
   allow delete: if teacher();
  }
  match /contentReads/{id} {
   allow read: if teacher() || (verified() && resource.data.uid == request.auth.uid);
   function validRead() {
    let d = request.resource.data;
    let source = d.kind == 'theme' ? {} : d.kind == 'announcement' ? get(/databases/$(database)/documents/announcements/$(d.recordId)).data : get(/databases/$(database)/documents/sessions/$(d.recordId)).data;
    return verified() && d.uid == request.auth.uid && d.kind in ['announcement','session','theme']
     && id == request.auth.uid + '_' + d.kind + '_' + d.recordId
     && d.keys().hasOnly(['uid','kind','recordId','version','courseId','batchId'])
     && shortString(d.recordId,1500) && shortString(d.version,200)
     && (d.kind == 'theme' ? d.recordId == 'appearance' && d.courseId == '' && d.batchId == '' : source.courseId == d.courseId && source.batchId == d.batchId && batchAllowed(d.batchId));
   }
   allow create: if validRead();
   allow update: if validRead() && resource.data.uid == request.auth.uid;
   allow delete: if teacher();
  }
  match /submissions/{id} {
   allow read: if teacher() || ownStudent(resource.data.studentId);
   allow create: if validSubmission(request.resource.data) && id == request.resource.data.studentId + '_' + request.resource.data.assignmentId
    && request.resource.data.keys().hasOnly(['studentId','assignmentId','courseId','answer','fileUrl','status','submittedAt','history','feedback','mark','formAnswers','late','timerId','timedOut'])
    && request.resource.data.feedback == '' && request.resource.data.mark == '' && request.resource.data.history == [];
   allow update: if teacher() || (validSubmission(request.resource.data) && ownStudent(resource.data.studentId)
    && resource.data.status in ['draft','returned'] && request.resource.data.history == resource.data.history
    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['answer','fileUrl','status','submittedAt','formAnswers','late','timerId','timedOut']));
   allow delete: if teacher();
  }
  match /attendance/{id} { allow read: if teacher() || ownStudent(resource.data.studentId); allow write: if teacher(); }
  match /studentAlerts/{id} { allow read: if teacher() || (ownStudent(resource.data.studentId) && resource.data.audience == 'student'); allow write: if teacher(); }
  match /feeMonths/{id} { allow read: if teacher() || ownStudent(resource.data.studentId); allow write: if teacher(); }
  match /paymentClaims/{id} {
   allow read: if teacher() || ownStudent(resource.data.studentId);
   allow create: if validClaim(request.resource.data) && request.resource.data.status == 'awaiting_review'
    && request.resource.data.keys().hasOnly(['studentId','batchId','month','amount','paidOn','reference','receiptUrl','status','createdAt','history'])
    && request.resource.data.history == [];
   allow update: if teacher() || (ownStudent(resource.data.studentId) && validClaim(request.resource.data)
    && resource.data.status == 'clarification_requested' && request.resource.data.status == 'awaiting_review'
    && request.resource.data.history == resource.data.history
    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['amount','paidOn','reference','receiptUrl','status']));
   allow delete: if teacher();
  }
  match /payments/{id} { allow read: if teacher() || ownStudent(resource.data.studentId); allow write: if teacher(); }
  match /tasks/{id} { allow read, write: if teacher(); }
  match /audit/{id} { allow read, create: if teacher(); allow update, delete: if false; }
  match /{document=**} { allow read, write: if false; }
 }
}
